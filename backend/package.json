{
  "name": "studyco-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file=.env --import tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "check": "tsc --noEmit && eslint .",
    "format": "prettier --write src tests scripts",
    "coverage": "vitest run --coverage",
    "test": "npm run check && vitest run --project unit --project integration && vitest run --project concurrency",
    "openapi": "npm run build && node dist/scripts/export-openapi.js"
  },
  "dependencies": {
    "@fastify/cors": "latest",
    "@fastify/helmet": "latest",
    "@fastify/jwt": "latest",
    "@fastify/rate-limit": "latest",
    "@fastify/swagger": "^9.9.3",
    "@fastify/swagger-ui": "^6.1.3",
    "argon2": "^0.45.2",
    "fastify": "latest",
    "fastify-type-provider-zod": "latest",
    "pg": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@types/node": "latest",
    "@types/pg": "latest",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "latest",
    "prettier": "^3.9.10",
    "tsx": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vitest": "latest"
  }
}
