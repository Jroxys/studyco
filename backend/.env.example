NODE_ENV=development
PORT=3000
HOST=127.0.0.1
DATABASE_URL=change-this-to-your-postgresql-url
JWT_SECRET=change-this-to-a-unique-random-32-character-minimum-jwt-secret
JWT_EXPIRES_IN=15m
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute
MINIMUM_AGE=16
OTP_TTL_MINUTES=15
OTP_MAX_ATTEMPTS=5
OTP_HMAC_SECRET=change-this-to-a-different-random-32-character-minimum-otp-secret
TRUST_PROXY=false
REQUIRE_VERIFIED_EMAIL=false
JOBS_ENABLED=true
JOB_INTERVAL_SECONDS=300
PG_POOL_MAX=10
PG_CONNECTION_TIMEOUT_MILLIS=5000
